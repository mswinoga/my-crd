          "x-crdkit-perTarget": "no",
          "x-crdkit-shared": true,
          "x-crdkit-type": "bool"
        },
        "environment": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              {
                "$ref": "#/definitions/tokenDeclaration"
              },
              {
                "$ref": "#/definitions/markers"
              }
            ],
            "description": "A variable: a scalar or a token declaration (target keys, default, match, annotation targetContainer).",
            "examples": [
              {
                "default": "db.internal",
                "prod": "db.prod.internal",
                "targetContainer": "main"
              }
            ],
            "markdownDescription": "A variable: a scalar or a token declaration (target keys, `default`, `match`, annotation `targetContainer`).",
            "x-crdkit-perTarget": "yes",
            "x-crdkit-type": "scalar"
          },
          "description": "Variables owned by the service, by name (\u003cID\u003e_-prefixed by convention).",
          "examples": [
            {
              "SHARED_DB_HOST": {
                "default": "db.internal",
                "prod": "db.prod.internal",
                "targetContainer": "main"
              }
            }
          ],
          "markdownDescription": "Variables owned by the service, by name (`\u003cID\u003e_`-prefixed by convention).",
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "type": "object",
          "x-crdkit-keyLabel": "\u003cNAME\u003e",
          "x-crdkit-shared": true,
          "x-crdkit-type": "map"
