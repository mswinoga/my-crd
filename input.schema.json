    "application.services.*[type=environment]": {
      "additionalProperties": false,
      "description": "A service that only declares variables.",
      "examples": [
        {
          "environment": {
            "SHARED_DB_HOST": {
              "default": "db.internal",
              "prod": "db.prod.internal",
              "targetContainer": "main"
            }
          },
          "type": "environment"
        }
      ],
      "markdownDescription": "A service that only declares variables.\n\n**Example output**\n\n`spec.application.services.SHARED` as rendered.\n\n```yaml\nenvironment:\n  SHARED_DB_HOST:\n    targetContainer: main\n    value: db.prod.internal\ntype: environment\n```",
      "properties": {
        "enabled": {
          "default": true,
          "description": "false removes the service from the output.",
          "markdownDescription": "`false` removes the service from the output.",
