references base example matches snapshot:
  1: |
    apiVersion: platform.company.io/v1
    kind: SomeCR
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: harness
        helm.sh/chart: harness-0.0.0
        platform.company.io/library-version: 0.0.6
      name: RELEASE-NAME
    spec:
      application:
        services:
          SVC1:
            environment:
              SVC1_GREETER:
                targetContainer: main
                value: SVC1
            type: greeter
          SVC2:
            environment:
              SVC2_SEED:
                targetContainer: main
                value: "5"
            references:
              - /spec/application/services/SVC1/environment/SVC1_GREETER
              - /spec/application/volumeMounts/SVC1-config/files/message
            type: leader
        volumeMounts:
          SVC1-config:
            files:
              message: hello
            source: configMap
