{{/*
mycrd.schema (internal)

The consumer values schema my-crd validates its input against
(crdkit.schema.*): the root keys my-crd reads, and one switch case per
service type.

Interface:
- Params: any value (passed on to the included schema defines).
- Returns YAML: the root schema node (see crdkit's
  templates/_schema.tpl for the node shape).

Implementation notes:
- The root is open (`values: {kind: any}`): the consumer chart's own
  keys and `global` live next to my-crd's.
- The service switch cases are generated by `range` over
  mycrd.serviceTypes, so the type list and the schema cannot drift
  apart; each case is `mycrd.serviceType.<type>.schema` (a missing one
  aborts the render).
*/}}
{{- define "mycrd.schema" -}}
kind: map
doc: "Consumer values of my-crd."
values:
  kind: any
  doc: "The consumer chart's own values; not read by my-crd."
properties:
  target:
    kind: scalar
    type: string
    markers: false
    doc: "Render target: `<env>` or `<env>-<seq>` (e.g. `prod-01`). Selects every per-target value."
  renderMode:
    kind: scalar
    markers: false
    doc: "`validate` prints the render with its diagnostics; `deploy` (default) aborts on errors."
  metadata:
    kind: map
    doc: "Metadata of the rendered object."
    properties:
      labels:
        kind: map
        doc: "Labels copied onto the rendered object; standard labels win on a collision."
        values:
          kind: scalar
          type: string
          tokens: false
          doc: "Label value; may hold `@NAME@` markers."
  application:
    kind: map
    doc: "The application the object describes."
    properties:
      services:
        kind: map
        doc: "Services by ID."
        keys:
          pattern: "^[A-Z0-9_]+$"
        values:
          doc: "One service; its keys depend on `type`."
          switch:
            by: type
            cases:
              {{- range $type := (include "mycrd.serviceTypes" . | fromYaml).value }}
              {{ $type }}:
                {{- include (printf "mycrd.serviceType.%s.schema" $type) $ | nindent 16 }}
              {{- end }}
{{- end -}}

{{/*
mycrd.schema.serviceBase (internal)

The keys every service accepts, whatever its type: `type`, `enabled`,
`environment`. Each `mycrd.serviceType.<type>.schema` includes it into
its own `properties`.

Interface:
- Params: any value (ignored).
- Returns YAML: a `properties` map fragment (`{<key>: <node>}`).

Implementation notes:
- `type` is the switch key of the services map: `kind: scalar`,
  `markers: false` (crdkit's switch rule).
- `enabled` is static (`markers: false`); a non-boolean is an ERROR and
  the default `true` applies.
*/}}
{{- define "mycrd.schema.serviceBase" -}}
type:
  kind: scalar
  type: string
  markers: false
  doc: "Service type; selects the handler and the keys below."
enabled:
  kind: scalar
  type: bool
  markers: false
  default: true
  doc: "`false` removes the service from the output."
environment:
  kind: map
  doc: "Variables owned by the service, by name (`<ID>_`-prefixed by convention)."
  keys:
    pattern: "^[A-Z][A-Z0-9_]*$"
  values:
    kind: scalar
    tokens: true
    doc: "A variable: a scalar or a token declaration (target keys, `default`, `match`, annotation `targetContainer`)."
{{- end -}}
